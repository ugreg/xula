#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"

if git diff --cached --name-only --diff-filter=ACMR | grep -qE '^website/.*\.(js|html|css|svg|png|jpg|ico|woff2)$'; then
  ./website/bump.sh
  for f in $(git diff --name-only -- website); do
    if ./website/stamp-only.sh "$f"; then
      git add -- "$f"
    else
      echo "pre-commit: $f mixes stamps with your edits, run ./website/bump.sh and git add it yourself" >&2
    fi
  done
fi
