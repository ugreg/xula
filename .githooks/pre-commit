#!/bin/sh
set -eu

cd "$(git rev-parse --show-toplevel)"

STAMP_LINE='name="build-version"|\?v=[0-9]{12}(\.[0-9a-f]{40})?'

if git diff --cached --name-only --diff-filter=ACMR | grep -qE '^website/.*\.(js|html|css|svg|png|jpg|ico|woff2)$'; then
  ./website/bump.sh
  git diff --name-only -- website/ | while IFS= read -r f; do
    [ -f "$f" ] || continue
    changed=$(git diff -U0 -- "$f" | grep -E '^[-+]' | grep -vE '^[-+]{3} ' || true)
    [ -n "$changed" ] || continue
    if printf '%s\n' "$changed" | grep -vE "$STAMP_LINE" | grep -q .; then
      continue
    fi
    git add -- "$f"
  done
fi

exit 0
